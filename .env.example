# Both required. The service refuses to start without them rather than sitting silently
# idle. Create a bot by messaging @BotFather and take the token it prints; get the chat
# id by messaging @userinfobot, or add the bot to a group and read it from the logs.
# Send your bot a message once first -- Telegram will not let a bot open a conversation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone the alerts render in. Match wherever you read deadlines, so the message
# agrees with the page you click through to.
NOTIFIER_TZ=Europe/London

# How often the loop wakes, and how often it refetches both APIs. The defaults cost
# 48 requests a day and notice a moved deadline well before any alert for it.
NOTIFIER_POLL_SECONDS=60
NOTIFIER_REFRESH_SECONDS=3600

NOTIFIER_STATE_PATH=data/notifier_state.json

# Optional mini-league banter appended to each alert: comma-separated
# handle:fpl_name:team entries, e.g.
#   NOTIFIER_ROSTER=@romanusyk:Roman Usyk:Manchester United,@d_vodotiiets:Denys Vodotyets:Arsenal
# The older two-field handle:team form (no fpl_name) still works.
# Leave empty and only the lines needing no roster are used. NOTIFIER_BANTER=off
# disables it entirely.
NOTIFIER_ROSTER=
NOTIFIER_BANTER=on
