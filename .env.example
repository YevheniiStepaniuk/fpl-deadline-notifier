# Both required. The service refuses to start without them rather than sitting silently
# idle. Create a bot by messaging @BotFather and take the token it prints; get the chat
# id by messaging @userinfobot, or add the bot to a group and read it from the logs.
# Send your bot a message once first -- Telegram will not let a bot open a conversation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Timezone the alerts render in. Match wherever you read deadlines, so the message
# agrees with the page you click through to.
NOTIFIER_TZ=Europe/London

# How often the loop wakes, and how often it refetches both APIs. The defaults cost
# 48 requests a day and notice a moved deadline well before any alert for it.
NOTIFIER_POLL_SECONDS=60
NOTIFIER_REFRESH_SECONDS=3600

NOTIFIER_STATE_PATH=data/notifier_state.json

# Optional mini-league banter appended to each alert: comma-separated handle:team pairs.
# Leave empty and only the lines needing no roster are used. NOTIFIER_BANTER=off
# disables it entirely.
NOTIFIER_ROSTER=
NOTIFIER_BANTER=on

# Optional: write the banter with an AI instead, from the league's live state -- the
# table, and each manager's latest transfers and waiver claims. Needs a league id and
# an OpenRouter key; with either missing the twenty built-in lines are used instead,
# which is also what happens on any failure. NOTIFIER_BANTER_AI=off pins the built-in
# lines even when both are set.
#
# The ids are the numbers in the URL of the league page you already look at:
#   fantasy.premierleague.com/leagues/<id>/standings/c
#   draft.premierleague.com/league/<id>/standings
# Either one alone is enough; both is better, since the two games publish different
# things to be rude about.
NOTIFIER_FPL_LEAGUE_ID=
NOTIFIER_DRAFT_LEAGUE_ID=
NOTIFIER_BANTER_AI=on

# The key is deliberately un-prefixed: it is the same OPENROUTER_API_KEY the dashboard
# this notifier was extracted from already reads, so one .env holds one key rather than
# two that can disagree. A line costs a fraction of a cent, and ai_banter.COOLDOWN caps
# how often one can be asked for -- /nextdeadline is answerable by anyone in the chat.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Banter-only model override. Set this and the dashboard keeps OPENROUTER_MODEL: a
# one-sentence joke and a page of prose want different models. Reasoning is switched
# off in the request, so a reasoning model here costs roughly what a cheap one does
# (deepseek/deepseek-v4-pro-0813: $0.0002 a line with it off, $0.0027 with it on).
NOTIFIER_BANTER_MODEL=

# Telegram handle -> the manager name the league publishes, comma-separated `handle=Name`
# pairs. Only needed where the two share no letters: handles that resemble the name are
# matched without this (whole-string, then per surname). With a mapping the alert can
# @-mention whoever it is about; without one it uses their name off the API and nobody is
# notified. Surname spelling drift between what you type here and what the API holds is
# tolerated, first-name-only ties break in favour of an exact full-name match.
NOTIFIER_BANTER_ALIASES=
